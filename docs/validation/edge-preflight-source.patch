-    decoder->mark_pulses = 0U;
-    decoder->final_pulses = 0U;
-    decoder->bit_count = 0U;
-    decoder->byte_value = 0U;
-    decoder->byte_index = 0UL;
-    decoder->checksum = 0U;
-    decoder->recorded_checksum = 0U;
-    decoder->copy_index = 0U;
-}
